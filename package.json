{
  "name": "@godtech/forge",
  "version": "0.6.2",
  "description": "A reusable operating framework for deliberate, verified AI-assisted product engineering.",
  "type": "module",
  "bin": {
    "forge": "dist/src/entry.js"
  },
  "files": [
    "dist/src",
    "dist/framework"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && node forge/scripts/copy-framework.mjs",
